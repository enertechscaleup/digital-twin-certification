{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dashboard",
      "runtimeExecutable": ".venv/bin/uvicorn",
      "runtimeArgs": [
        "app.main:app",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "platform-preview",
      "runtimeExecutable": "web/node_modules/.bin/vite",
      "runtimeArgs": [
        "web",
        "--port",
        "5174",
        "--strictPort"
      ],
      "port": 5174
    }
  ]
}
